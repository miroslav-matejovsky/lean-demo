{
  "specVersion": "1.0.0",
  "constants": {"approvalThreshold": 1000000, "maxLines": 10, "maxQty": 10000, "maxUnitPrice": 100000000},
  "statuses": ["Draft", "PendingApproval", "Approved", "Shipped", "Cancelled"],
  "errorCodes": ["InvalidQuantity", "InvalidPrice", "TooManyLines", "EmptyOrder", "InvalidTransition"],
  "events": [
    {"type": "AddLine", "fields": ["sku", "qty", "unitPrice"]},
    {"type": "Submit"},
    {"type": "Approve"},
    {"type": "Reject"},
    {"type": "Ship"},
    {"type": "Cancel"}
  ]
}
